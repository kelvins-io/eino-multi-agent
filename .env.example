# Copy to .env or export in the shell. Env vars override config.yaml.

EINO_CONFIG=./config.yaml

EINO_SERVER_ADDR=:8180
# debug|info|warn|error
# EINO_LOG_LEVEL=info
# console|json
# EINO_LOG_FORMAT=console
# 同时按天写文件：./logs/eino-YYYY-MM-DD.log，默认保留 14 天
# EINO_LOG_FILE=./logs/eino.log
# EINO_LOG_KEEP_DAYS=14
EINO_DATABASE_DSN=postgres://eino:eino@127.0.0.1:14432/eino_work?sslmode=disable

# JWT（用户注册/登录鉴权）
EINO_JWT_SECRET=eino-dev-jwt-secret-change-me
EINO_JWT_EXPIRE=168h
# 可选：静态 Bearer，与 JWT 并存，便于 CLI
# EINO_AUTH_TOKEN=
# CLI 调用 API 时的 Bearer（登录后拿到的 JWT，或静态 token）
# EINO_API_TOKEN=

EINO_LLM_PROVIDER=openai
EINO_LLM_API_KEY=
EINO_LLM_BASE_URL=
EINO_LLM_MODEL=gpt-4o

# Example: Doubao / Volcengine Ark
# EINO_LLM_PROVIDER=ark
# EINO_LLM_API_KEY=your-ark-key
# EINO_LLM_MODEL=doubao-seed-2-1-turbo-260628
# 主模型触发安全体验额度限制时，换成控制台里仍开通的接入点
# EINO_LLM_FALLBACK_MODELS=doubao-seed-1-6-250115
# 单次模型调用超时（含流式读 body）。豆包推理模型建议至少 10m
# EINO_LLM_TIMEOUT=10m

# Example: local Ollama
# EINO_LLM_PROVIDER=ollama
# EINO_LLM_BASE_URL=http://127.0.0.1:11434
# EINO_LLM_MODEL=qwen2.5:14b

EINO_WORKSPACE_ROOT=./workspace
EINO_SKILLS_DIR=./skills
