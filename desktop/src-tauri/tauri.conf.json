{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eino Multi Agent",
  "version": "0.1.0",
  "identifier": "io.kelvins.eino-multi-agent",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eino Multi Agent",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Eino long-running work harness console",
    "longDescription": "Desktop shell for the Eino multi-agent work harness. Connects to a running API server.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
